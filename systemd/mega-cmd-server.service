# mega-cmd-server.service: run the MEGAcmd engine from login.
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Installed by make install-core and the core package; each user turns it on
# for themselves with
#   systemctl --user enable --now mega-cmd-server.service
# For a mega-cmd-server outside /usr/bin and /usr/local/bin, give its path in
# an override made with systemctl --user edit mega-cmd-server.service: an
# empty "ExecStart=" line, then "ExecStart=/path/to/mega-cmd-server".

[Unit]
Description=MEGAcmd sync and backup engine

[Service]
ExecStart=mega-cmd-server
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
